# Скопируйте этот файл в ".env" (с точкой в начале) и при необходимости заполните.
# Токен Ujin от организаторов. Пусто -> используются данные из fallback.json
UJIN_TOKEN=
UJIN_BASE_URL=https://hck-api.unicorn.icu
# Пути методов Ujin — поправьте по Open API.yaml
UJIN_NEWS_PATH=/api/v1/news/list
UJIN_PARKING_PATH=/api/v1/parking/list
UJIN_STORAGE_PATH=/api/v1/storage/list
# Токен сотрудника УК для панели. Пусто -> демо-режим без проверки
UK_TOKEN=
